# ==============================================================================
# reco / SwarmLead FDE Agent Platform - Environment Configuration Template
# Copy this file to .env and fill in any provider keys as needed.
# All features work out of the box with zero external keys using mock/deterministic mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="SwarmLead FDE Agent Platform"
DEBUG=true
HOST=0.0.0.0
PORT=8000
# Production secret key for cryptographic signatures and token hashing (min 32 bytes)
SECRET_KEY=reco_fde_secret_signing_key_change_in_production_32bytes

# Database connection URL (Async SQLite by default, or PostgreSQL e.g. postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///./fde_swarm.db

# Allowed CORS Origins (comma-separated list for frontend dev and production servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. FRONTEND (VITE & CLIENT CONFIGURATION)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000/api
VITE_APP_TITLE="reco | Autonomous FDE Swarm Orchestration Floor"

# ------------------------------------------------------------------------------
# 3. LLM PROVIDERS (FAST CLOUD INFERENCE)
# Priority: Groq LPU (Instant) -> Gemini -> OpenAI -> Deterministic Fallback
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini / Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local LLaMA / Ollama (Disabled by default to eliminate local inference delay)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Execution Timeouts & SLA Guards (2-3 minute boundary)
REQUEST_TIMEOUT_SECONDS=150
LLM_CALL_TIMEOUT=15

DEFAULT_MODEL=openai/gpt-oss-120b
MOCK_MODE_IF_NO_KEY=true

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & EVALUATIONS (LANGSMITH / LANGCHAIN)
# Dashboard: https://smith.langchain.com
# ------------------------------------------------------------------------------
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=reco-agent
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=fde-swarm-reco
LANGCHAIN_PROJECT=fde-swarm-reco
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# 5. DEFENSIVE RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_SOLVE=10
