# ==============================================================================
# Free AI Providers (Optional - Zero-cost local fallback engine active by default!)
# ==============================================================================

# Option 1: Groq Cloud (Free high-speed tier with LLaMA 3.3 70B / 3.1 8B)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option 2: Google Gemini (Free tier available with no credit card required)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Option 3: Ollama (100% Free Local Open Source Models, e.g. llama3, deepseek-r1)
# Install from https://ollama.ai and run: ollama run llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Option 4: OpenAI
OPENAI_API_KEY=

# ==============================================================================
# LangSmith Observability & Evaluations
# ==============================================================================
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=fde-swarm-taskforce-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==============================================================================
# Database
# ==============================================================================
DATABASE_URL=sqlite+aiosqlite:///./fde_swarm.db
